{
  "expo": {
    "name": "Little Ape TV",
    "slug": "little-ape-tv",
    "version": "0.5.0",
    "scheme": "little-ape-tv",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-launcher",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-background-task",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1b2829",
          "image": "./assets/little-ape-tv-splash.png",
          "resizeMode": "contain",
          "enableFullScreenImage_legacy": true
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true,
      "reactCompiler": false
    },
    "orientation": "portrait",
    "icon": "./assets/little-ape-tv-icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.markmccoid.littleapetv",
      "infoPlist": {
        "UIBackgroundModes": ["processing"],
        "NSBackgroundProcessingAPIs": ["BackgroundTask"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.markmccoid.littleapetv"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8b24a12f-dc07-4f44-9017-f99c0bb81b42"
      }
    }
  }
}
